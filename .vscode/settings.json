{
  // --- interpreter -------------------------------------------------------
  // VS Code auto-detects a .venv/ in the workspace root. If it does not,
  // run "Python: Select Interpreter" from the command palette (Ctrl+Shift+P)
  // and pick .venv (Windows: .venv\Scripts\python.exe).

  // Makes go-to-definition and autocomplete work with the src/ layout even
  // before `pip install -e .`. After installing, this is harmless.
  "python.analysis.extraPaths": ["src"],
  "python.analysis.autoImportCompletions": true,
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.inlayHints.functionReturnTypes": true,

  // --- tests -------------------------------------------------------------
  // Tests appear in the Testing panel (the flask icon in the sidebar) and
  // can be run or debugged individually from the gutter arrows.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // --- editor ------------------------------------------------------------
  "editor.rulers": [100],
  "editor.formatOnSave": false,
  // Ruff config lives in pyproject.toml ([tool.ruff]).
  "ruff.enable": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[yaml]": {
    "editor.tabSize": 2
  },

  // --- keep the file tree and search readable ----------------------------
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.egg-info": true,
    "**/.pytest_cache": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/.newal": true,
    "**/__pycache__": true,
    "**/*.egg-info": true
  },
  // .newal/ holds the memory DB and server logs -- generated, not source.
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/.newal/**": true
  }
}
